<?xml version="1.0" encoding="utf-8"?>
<!--
  La misma tarjeta en dos estados: compacta cuando no suena, y crecida
  cuando si, con la cancion y sus acciones. Asi la emisora que esta sonando
  es el foco de la pantalla en vez de una fila igual que la otra.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp">

            <View
                android:id="@+id/iconBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle" />

            <ImageView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="@color/txt"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ecualizador: se anima solo mientras suena -->
        <LinearLayout
            android:id="@+id/eq"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/bar1"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bar_bg" />

            <View
                android:id="@+id/bar2"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bar_bg" />

            <View
                android:id="@+id/bar3"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/bar_bg" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/dim2"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- lo que solo aparece cuando se sabe que suena -->
    <LinearLayout
        android:id="@+id/expand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/txt"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLyrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/pill_bg"
                android:drawableStart="@drawable/ic_lyrics_small"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp"
                android:text="@string/lyrics"
                android:textColor="@color/txt"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_bg"
                android:drawableStart="@drawable/ic_music_search_small"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp"
                android:text="@string/music"
                android:textColor="@color/txt"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
