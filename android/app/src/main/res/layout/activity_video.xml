<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <!-- Flecha de volver. Aparece y desaparece con el resto de controles: la
         pantalla esta a pantalla completa y sin esto hay que fiarse del gesto
         del sistema, que no se ve por ninguna parte. -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/scrim_circle"
        android:contentDescription="@string/back"
        android:padding="14dp"
        android:src="@drawable/ic_back"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@color/txt"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
